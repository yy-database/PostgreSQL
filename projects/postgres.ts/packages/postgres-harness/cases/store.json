{
    "shardFile": "local-0.yykv",
    "catalogFile": "local-0.yyds",
    "cases": [
        {
            "name": "empty-open",
            "ops": [
                { "op": "open" },
                { "op": "expectFiles" },
                { "op": "verifyCatalog", "expect": { "magic": "5959445301", "version": 0, "schema": null, "routingEpoch": null, "shards": ["local-0"], "contract": null, "owners": [] } },
                { "op": "namespaces", "expectNamespaces": [] },
                { "op": "len", "namespace": "public.empty", "expectLen": 0 },
                { "op": "reopen" },
                { "op": "expectFiles" },
                { "op": "namespaces", "expectNamespaces": [] }
            ]
        },
        {
            "name": "put-and-get",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "public.users", "key": "u1", "value": "alice" },
                { "op": "put", "namespace": "public.users", "key": "u2", "value": "bob" },
                { "op": "get", "namespace": "public.users", "key": "u1", "expect": "alice" },
                { "op": "get", "namespace": "public.users", "key": "u2", "expect": "bob" },
                { "op": "get", "namespace": "public.users", "key": "u3", "expect": null },
                { "op": "len", "namespace": "public.users", "expectLen": 2 },
                { "op": "verifyShard", "nextRevision": 3, "records": [
                    { "namespace": "public.users", "key": "u1", "value": "alice", "revision": 1 },
                    { "namespace": "public.users", "key": "u2", "value": "bob", "revision": 2 }
                ] },
                { "op": "verifyCatalog", "expect": { "magic": "5959445301", "version": 0, "schema": null, "routingEpoch": null, "shards": ["local-0"], "contract": null, "owners": [] } }
            ]
        },
        {
            "name": "overwrite-keeps-one-record",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "public.users", "key": "u1", "value": "first" },
                { "op": "put", "namespace": "public.users", "key": "u1", "value": "second" },
                { "op": "get", "namespace": "public.users", "key": "u1", "expect": "second" },
                { "op": "len", "namespace": "public.users", "expectLen": 1 },
                { "op": "verifyShard", "nextRevision": 3, "records": [
                    { "namespace": "public.users", "key": "u1", "value": "second", "revision": 2 }
                ] }
            ]
        },
        {
            "name": "delete-report-and-miss",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "public.users", "key": "u1", "value": "alice" },
                { "op": "delete", "namespace": "public.users", "key": "u1", "expectDeleted": true },
                { "op": "get", "namespace": "public.users", "key": "u1", "expect": null },
                { "op": "delete", "namespace": "public.users", "key": "u1", "expectDeleted": false },
                { "op": "len", "namespace": "public.users", "expectLen": 0 }
            ]
        },
        {
            "name": "keys-with-prefix",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "public.fruit", "key": "banana", "value": "yellow" },
                { "op": "put", "namespace": "public.fruit", "key": "apple", "value": "red" },
                { "op": "put", "namespace": "public.fruit", "key": "apricot", "value": "orange" },
                { "op": "keys", "namespace": "public.fruit", "prefix": "ap", "expectKeys": ["apple", "apricot"] },
                { "op": "keys", "namespace": "public.fruit", "prefix": "", "expectKeys": ["apple", "apricot", "banana"] },
                { "op": "keys", "namespace": "public.fruit", "prefix": "zz", "expectKeys": [] }
            ]
        },
        {
            "name": "scan-pairs",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "public.fruit", "key": "b", "value": "2" },
                { "op": "put", "namespace": "public.fruit", "key": "a", "value": "1" },
                { "op": "scan", "namespace": "public.fruit", "prefix": "", "expectPairs": [["a", "1"], ["b", "2"]] },
                { "op": "scan", "namespace": "public.fruit", "prefix": "b", "expectPairs": [["b", "2"]] }
            ]
        },
        {
            "name": "namespaces-are-isolated",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "db1.users", "key": "id1", "value": "one" },
                { "op": "put", "namespace": "db2.users", "key": "id1", "value": "two" },
                { "op": "get", "namespace": "db1.users", "key": "id1", "expect": "one" },
                { "op": "get", "namespace": "db2.users", "key": "id1", "expect": "two" },
                { "op": "namespaces", "expectNamespaces": ["db1.users", "db2.users"] },
                { "op": "len", "namespace": "db1.users", "expectLen": 1 },
                { "op": "len", "namespace": "db2.users", "expectLen": 1 }
            ]
        },
        {
            "name": "reopen-persists-values",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "public.users", "key": "u1", "value": "alice" },
                { "op": "reopen" },
                { "op": "get", "namespace": "public.users", "key": "u1", "expect": "alice" },
                { "op": "namespaces", "expectNamespaces": ["public.users"] },
                { "op": "put", "namespace": "public.users", "key": "u2", "value": "bob" },
                { "op": "get", "namespace": "public.users", "key": "u2", "expect": "bob" },
                { "op": "verifyShard", "nextRevision": 3, "records": [
                    { "namespace": "public.users", "key": "u1", "value": "alice", "revision": 1 },
                    { "namespace": "public.users", "key": "u2", "value": "bob", "revision": 2 }
                ] }
            ]
        },
        {
            "name": "flush-namespace",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "public.tmp", "key": "a", "value": "1" },
                { "op": "put", "namespace": "public.tmp", "key": "b", "value": "2" },
                { "op": "put", "namespace": "public.keep", "key": "c", "value": "3" },
                { "op": "flush", "namespace": "public.tmp", "expectRemoved": 2 },
                { "op": "keys", "namespace": "public.tmp", "prefix": "", "expectKeys": [] },
                { "op": "len", "namespace": "public.tmp", "expectLen": 0 },
                { "op": "namespaces", "expectNamespaces": ["public.keep"] },
                { "op": "get", "namespace": "public.keep", "key": "c", "expect": "3" }
            ]
        },
        {
            "name": "shard-file-recovery",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "public.users", "key": "u1", "value": "alice" },
                { "op": "reopen" },
                { "op": "removeShard" },
                { "op": "reopen" },
                { "op": "namespaces", "expectNamespaces": [] },
                { "op": "get", "namespace": "public.users", "key": "u1", "expect": null },
                { "op": "put", "namespace": "public.users", "key": "u2", "value": "bob" },
                { "op": "get", "namespace": "public.users", "key": "u2", "expect": "bob" }
            ]
        },
        {
            "name": "catalog-file-recovery",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "public.users", "key": "u1", "value": "alice" },
                { "op": "removeCatalog" },
                { "op": "reopen" },
                { "op": "get", "namespace": "public.users", "key": "u1", "expect": "alice" },
                { "op": "expectFiles" }
            ]
        },
        {
            "name": "corrupt-shard-magic",
            "ops": [
                { "op": "open" },
                { "op": "writeShard", "hex": "5a5a5a5a5a" },
                { "op": "openExpectError", "expectError": "unknown .yykv header" }
            ]
        },
        {
            "name": "corrupt-shard-truncated",
            "ops": [
                { "op": "open" },
                { "op": "writeShard", "hex": "59594b5603" },
                { "op": "openExpectError", "expectError": "truncated shard checksum" }
            ]
        },
        {
            "name": "corrupt-shard-checksum",
            "ops": [
                { "op": "open" },
                { "op": "writeShard", "hex": "59594b5603000000000000000000" },
                { "op": "openExpectError", "expectError": ".yykv checksum mismatch" }
            ]
        },
        {
            "name": "legacy-shard-v2",
            "ops": [
                { "op": "open" },
                { "op": "writeShard", "hex": "59594b5602000000000000000000" },
                { "op": "openExpectError", "expectError": "legacy .yykv v2 snapshot carries no checksum: delete the shard and let the node recreate it" }
            ]
        },
        {
            "name": "corrupt-catalog-magic",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "5a5a5a5a5a00000000" },
                { "op": "openExpectError", "expectError": "invalid .yyds catalog: unknown catalog header" }
            ]
        },
        {
            "name": "corrupt-catalog-version",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "5959445301010000000000000000000000" },
                { "op": "openExpectError", "expectError": "invalid .yyds catalog: catalog format version requires regeneration" }
            ]
        },
        {
            "name": "corrupt-catalog-truncated",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "5959445301" },
                { "op": "openExpectError", "expectError": "invalid .yyds catalog: unexpected catalog eof" }
            ]
        },
        {
            "name": "catalog-interop-full-shape-seed",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "59594453010000000001000000010000000d0000007b2276657273696f6e223a317d010000007b0000000000000001000000070000006c6f63616c2d300000000001000000070000006c6f63616c2d30060000006e6f64652d610700000000000000" },
                { "op": "writeShard", "hex": "59594b5603e42b42c2392d245f010000000000000000000000" },
                { "op": "reopen" },
                { "op": "verifyCatalog", "expect": { "magic": "5959445301", "version": 0, "schema": { "version": 1, "document": "{\"version\":1}" }, "routingEpoch": 123, "shards": ["local-0"], "contract": null, "owners": [ { "shard": "local-0", "node": "node-a", "term": 7 } ] } },
                { "op": "get", "namespace": "public.seed", "key": "absent", "expect": null },
                { "op": "expectFiles" }
            ]
        },
        {
            "name": "catalog-authoritative-shard-id",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "59594453010000000000000000000000000100000008000000637573746f6d2d370000000000000000" },
                { "op": "writeSibling", "name": "custom-7.yykv", "hex": "59594b5603e42b42c2392d245f010000000000000000000000" },
                { "op": "reopen" },
                { "op": "expectFiles", "shardFile": "custom-7.yykv" },
                { "op": "put", "namespace": "public.seed", "key": "k", "value": "v" },
                { "op": "get", "namespace": "public.seed", "key": "k", "expect": "v" }
            ]
        },
        {
            "name": "catalog-legacy-big-endian",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "59594453010000000000000000000000010000000a706f7374677265732d300000000000000000" },
                { "op": "openExpectError", "expectError": "legacy PostgreSQL catalog layout: delete the store directory and reinitialize" }
            ]
        },
        {
            "name": "catalog-legacy-file-name",
            "ops": [
                { "op": "open" },
                { "op": "removeCatalog" },
                { "op": "writeSibling", "name": "postgres-0.yyds", "hex": "59594453010000000000000000000000010000000a706f7374677265732d300000000000000000" },
                { "op": "openExpectError", "expectError": "legacy PostgreSQL catalog layout: delete the store directory and reinitialize" }
            ]
        },
        {
            "name": "catalog-corrupt-trailing",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "595944530100000000000000000000000001000000070000006c6f63616c2d30000000000000000000000000" },
                { "op": "openExpectError", "expectError": "invalid .yyds catalog: trailing catalog bytes" }
            ]
        },
        {
            "name": "catalog-corrupt-count-zero",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "5959445301000000000000000000000000000000000000000000000000" },
                { "op": "openExpectError", "expectError": "unsupported catalog shard count" }
            ]
        },
        {
            "name": "catalog-corrupt-count-two",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "595944530100000000000000000000000002000000070000006c6f63616c2d30070000006c6f63616c2d310000000000000000" },
                { "op": "openExpectError", "expectError": "unsupported catalog shard count" }
            ]
        },
        {
            "name": "catalog-corrupt-schema-flag",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "5959445301000000000200000000000000" },
                { "op": "openExpectError", "expectError": "invalid .yyds catalog: invalid catalog schema presence flag" }
            ]
        },
        {
            "name": "catalog-corrupt-routing-flag",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "5959445301000000000000000002000000" },
                { "op": "openExpectError", "expectError": "invalid .yyds catalog: invalid catalog routing presence flag" }
            ]
        },
        {
            "name": "catalog-corrupt-routing-epoch",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "5959445301000000000000000001000000000000000000000001000000070000006c6f63616c2d30" },
                { "op": "openExpectError", "expectError": "invalid .yyds catalog: invalid catalog routing epoch" }
            ]
        },
        {
            "name": "catalog-corrupt-contract-flag",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "595944530100000000000000000000000001000000070000006c6f63616c2d3002000000" },
                { "op": "openExpectError", "expectError": "invalid .yyds catalog: invalid resolved contract presence flag" }
            ]
        },
        {
            "name": "catalog-corrupt-shard-id",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "595944530100000000000000000000000001000000000000000000000000000000" },
                { "op": "openExpectError", "expectError": "catalog shard id is unusable" }
            ]
        },
        {
            "name": "catalog-corrupt-owner-utf8",
            "ops": [
                { "op": "open" },
                { "op": "writeCatalog", "hex": "595944530100000000000000000000000001000000070000006c6f63616c2d30000000000100000001000000ff" },
                { "op": "openExpectError", "expectError": "invalid .yyds catalog: catalog owner shard utf8" }
            ]
        },
        {
            "name": "unicode-keys-and-values",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "public.中文", "key": "键", "value": "值" },
                { "op": "get", "namespace": "public.中文", "key": "键", "expect": "值" },
                { "op": "keys", "namespace": "public.中文", "prefix": "键", "expectKeys": ["键"] },
                { "op": "namespaces", "expectNamespaces": ["public.中文"] }
            ]
        },
        {
            "name": "namespace-validation",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "", "key": "k", "value": "v", "expectError": "namespace must not be empty" },
                { "op": "put", "namespace": "public.\u0000bad", "key": "k", "value": "v", "expectError": "namespace must not contain a NUL byte" },
                { "op": "len", "namespace": "public.ok", "expectLen": 0 }
            ]
        },
        {
            "name": "revision-stays-monotonic-across-reopen",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "public.seq", "key": "a", "value": "1" },
                { "op": "put", "namespace": "public.seq", "key": "b", "value": "2" },
                { "op": "reopen" },
                { "op": "verifyShard", "nextRevision": 3, "records": [
                    { "namespace": "public.seq", "key": "a", "value": "1", "revision": 1 },
                    { "namespace": "public.seq", "key": "b", "value": "2", "revision": 2 }
                ] },
                { "op": "put", "namespace": "public.seq", "key": "c", "value": "3" },
                { "op": "verifyShard", "nextRevision": 4, "records": [
                    { "namespace": "public.seq", "key": "a", "value": "1", "revision": 1 },
                    { "namespace": "public.seq", "key": "b", "value": "2", "revision": 2 },
                    { "namespace": "public.seq", "key": "c", "value": "3", "revision": 3 }
                ] }
            ]
        },
        {
            "name": "table-group-shard-colocates",
            "ops": [
                { "op": "open" },
                { "op": "put", "namespace": "pg_data.16384", "key": "0000000001", "value": "[1,\"one\"]" },
                { "op": "put", "namespace": "pg_index.16385", "key": "one", "value": "0000000001" },
                { "op": "put", "namespace": "pg_data.16384", "key": "0000000002", "value": "[2,\"two\"]" },
                { "op": "verifyShard", "nextRevision": 4, "records": [
                    { "namespace": "pg_data.16384", "key": "0000000001", "value": "[1,\"one\"]", "revision": 1 },
                    { "namespace": "pg_data.16384", "key": "0000000002", "value": "[2,\"two\"]", "revision": 3 },
                    { "namespace": "pg_index.16385", "key": "one", "value": "0000000001", "revision": 2 }
                ] },
                { "op": "namespaces", "expectNamespaces": ["pg_data.16384", "pg_index.16385"] },
                { "op": "reopen" },
                { "op": "get", "namespace": "pg_index.16385", "key": "one", "expect": "0000000001" },
                { "op": "verifyCatalog", "expect": { "magic": "5959445301", "version": 0, "schema": null, "routingEpoch": null, "shards": ["local-0"], "contract": null, "owners": [] } }
            ]
        },
        {
            "name": "primary-ignores-sibling-group-shards",
            "ops": [
                { "op": "open" },
                { "op": "writeSibling", "name": "local-16384-706f737467726573.yykv", "hex": "59594b5603e42b42c2392d245f010000000000000000000000" },
                { "op": "reopen" },
                { "op": "expectFiles" },
                { "op": "put", "namespace": "pg_catalog", "key": "catalog", "value": "{}" },
                { "op": "get", "namespace": "pg_catalog", "key": "catalog", "expect": "{}" },
                { "op": "namespaces", "expectNamespaces": ["pg_catalog"] }
            ]
        }
    ]
}
